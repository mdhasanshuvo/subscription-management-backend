{
  "info": {
    "name": "Subscription & Billing API System",
    "_postman_id": "7c8c9d7b-4d2f-4f4d-8c2b-8c2f2a8f1a11",
    "description": "Postman collection for the subscription and billing API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Plans",
      "item": [
        {
          "name": "List Active Plans",
          "request": { "method": "GET", "url": "{{baseUrl}}/plans" }
        },
        {
          "name": "Create Plan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planName\": \"Pro\",\n  \"price\": 49.99,\n  \"durationInDays\": 30,\n  \"features\": [\"Priority support\", \"Team seats\"]\n}"
            },
            "url": "{{baseUrl}}/plans"
          }
        },
        {
          "name": "Update Plan",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 59.99\n}"
            },
            "url": "{{baseUrl}}/plans/{{planId}}"
          }
        },
        {
          "name": "Delete Plan",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/plans/{{planId}}"
          }
        }
      ]
    },
    {
      "name": "Subscriptions",
      "item": [
        {
          "name": "Purchase Subscription",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planId}}\",\n  \"autoRenew\": true\n}"
            },
            "url": "{{baseUrl}}/subscriptions/purchase"
          }
        },
        {
          "name": "Upgrade Subscription",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{upgradePlanId}}\",\n  \"autoRenew\": true\n}"
            },
            "url": "{{baseUrl}}/subscriptions/upgrade"
          }
        },
        {
          "name": "Downgrade Subscription",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{downgradePlanId}}\",\n  \"autoRenew\": false\n}"
            },
            "url": "{{baseUrl}}/subscriptions/downgrade"
          }
        },
        {
          "name": "Cancel Subscription",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/subscriptions/cancel"
          }
        },
        {
          "name": "My History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/subscriptions/me/history"
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Admin Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/analytics/admin/dashboard"
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Payment Update",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-webhook-secret", "value": "{{webhookSecret}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subscriptionId\": \"{{subscriptionId}}\",\n  \"eventType\": \"payment_success\",\n  \"metadata\": {\n    \"transactionId\": \"txn_123\"\n  }\n}"
            },
            "url": "{{baseUrl}}/webhook/payment-update"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "planId", "value": "" },
    { "key": "upgradePlanId", "value": "" },
    { "key": "downgradePlanId", "value": "" },
    { "key": "subscriptionId", "value": "" },
    { "key": "webhookSecret", "value": "" }
  ]
}
